{
  "tools": [
    {
      "name": "kubectl-shadewright",
      "repo": "pkalin/shadewright",
      "tag_pattern": "^v(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
      "asset_template": "kubectl-shadewright_{version}_{os}_{arch}.tar.gz",
      "checksums_asset": "checksums.txt",
      "platforms": ["darwin/amd64", "darwin/arm64", "linux/amd64", "linux/arm64"],
      "binary": "kubectl-shadewright",
      "test_args": ["version"],
      "description": "kubectl plugin for the Shadewright Kubernetes operations agent",
      "homepage": "https://shadewright.io",
      "license": "Apache-2.0"
    }
  ]
}
